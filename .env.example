# Sao chép file này thành .env (hoặc .env.local) rồi điền giá trị thật.

# Gemini (Tuần 2: chatbot hỏi đáp trên trang chủ)
GEMINI_API_KEY=

# Supabase (Tuần 3: lưu hội thoại chatbot; sau này mở rộng cho requests/schools + auth)
# Dùng ở phía server (route handlers, server components) qua @supabase/server —
# không thêm tiền tố NEXT_PUBLIC_, các biến này không được lộ ra trình duyệt.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
